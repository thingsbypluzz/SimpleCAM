# Must be a name the server's FTPS certificate is issued for — the cert
# covers *.v101.vh.net.pl, not ftp.vh11566.vh.net.pl (same server).
FTP_HOST=v101.vh.net.pl
FTP_PORT=21
FTP_USER=claude@onlypaths.pluzz.pl
FTP_PASSWORD=
FTP_REMOTE_PATH=/
# Explicit FTPS (AUTH TLS) is on by default. Set to "false" only if the
# server rejects the TLS handshake entirely — falls back to plain,
# unencrypted FTP.
FTP_SECURE=true
# The FTPS certificate is always verified. The server omits the Let's
# Encrypt intermediate, so scripts/certs/lets-encrypt-yr1-chain.pem supplies
# it; point FTP_CA_FILE at another PEM only if the issuer changes.
# FTP_CA_FILE=
