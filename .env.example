FTP_HOST=ftp.vh11566.vh.net.pl
FTP_PORT=21
FTP_USER=claude@simplecam.pluzz.pl
FTP_PASSWORD=
FTP_REMOTE_PATH=/
# Explicit FTPS (AUTH TLS) is on by default. Set to "false" only if the
# server rejects the TLS handshake entirely — falls back to plain,
# unencrypted FTP.
FTP_SECURE=true
# Shared cPanel hosts often present an FTPS certificate Node can't chain
# to a trusted root ("unable to verify the first certificate"). The
# connection is still encrypted; this just skips verifying who signed
# the certificate. Set to "false" if you hit that error.
FTP_REJECT_UNAUTHORIZED=true
